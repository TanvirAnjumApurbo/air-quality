# --- data (never committed) ---
# Anchored with a leading slash: an unanchored `data/` also matches src/data/,
# which silently drops that package from the repository.
/data/

# --- environments ---
.venv/
venv/
env/
.pipcache/

# --- python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- model artefacts ---
*.ckpt
*.pt
*.pth
*.joblib
*.pkl

# --- green-ai / codecarbon ---
emissions.csv
.codecarbon.config

# --- secrets ---
.env
*.key

# --- os / editor ---
.DS_Store
Thumbs.db
*.swp

# --- scratch notebooks (exploration only, not the pipeline) ---
notebooks/scratch/

# Claude session scratch, kept on the project drive rather than C:
/.scratch/

# --- LaTeX build artefacts (regenerate on every compile) ---
# Scoped to the paper folder on purpose: an unanchored *.log would also drop
# results/logs/, which this repo tracks deliberately.
PM2point5/*.aux
PM2point5/*.fdb_latexmk
PM2point5/*.fls
PM2point5/*.log
PM2point5/*.out
PM2point5/*.synctex.gz
PM2point5/*.bbl
PM2point5/*.blg
PM2point5/*.toc

# --- paper submission bundle (built from PM2point5/, not a source) ---
PM2point5.zip

# --- Claude Code per-machine settings (the skill files are tracked) ---
.claude/settings.local.json
